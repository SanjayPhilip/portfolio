# AI Traffic Analytics Platform - Environment Variables

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# YOLO Model
YOLO_MODEL=yolov8n.pt

# Upload Settings
MAX_UPLOAD_SIZE=500MB
UPLOAD_DIR=uploads
PROCESSED_DIR=processed
